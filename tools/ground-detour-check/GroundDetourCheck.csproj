<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <VnavDir>$(APPDATA)/XIVLauncher/devPlugins/vnavmesh</VnavDir>
    <DalamudDir>$(APPDATA)/XIVLauncher/addon/Hooks/dev</DalamudDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../FF14Accessibility/Services/GroundDetour.cs" Link="GroundDetour.cs" />
    <Reference Include="vnavmesh"><HintPath>$(VnavDir)/vnavmesh.dll</HintPath></Reference>
    <Reference Include="DotRecast.Core"><HintPath>$(VnavDir)/DotRecast.Core.dll</HintPath></Reference>
    <Reference Include="DotRecast.Detour"><HintPath>$(VnavDir)/DotRecast.Detour.dll</HintPath></Reference>
    <Reference Include="Dalamud"><HintPath>$(DalamudDir)/Dalamud.dll</HintPath></Reference>
  </ItemGroup>
</Project>
