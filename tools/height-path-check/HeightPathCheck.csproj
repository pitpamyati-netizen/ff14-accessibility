<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <VnavDir>$(APPDATA)/XIVLauncher/devPlugins/vnavmesh</VnavDir>
    <DalamudDir>$(APPDATA)/XIVLauncher/addon/Hooks/dev</DalamudDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../FF14Accessibility/Services/HeightPath.cs" Link="HeightPath.cs" />
    <Compile Include="../../FF14Accessibility/Services/GroundDetour.cs" Link="GroundDetour.cs" />
    <Compile Include="../../FF14Accessibility/Services/GroundTraversal.cs" Link="GroundTraversal.cs" />
    <Compile Include="../../FF14Accessibility/Services/AdaptiveGroundPath.cs" Link="AdaptiveGroundPath.cs" />
    <Reference Include="vnavmesh"><HintPath>$(VnavDir)/vnavmesh.dll</HintPath></Reference>
    <Reference Include="DotRecast.Core"><HintPath>$(VnavDir)/DotRecast.Core.dll</HintPath></Reference>
    <Reference Include="DotRecast.Detour"><HintPath>$(VnavDir)/DotRecast.Detour.dll</HintPath></Reference>
    <Reference Include="Dalamud"><HintPath>$(DalamudDir)/Dalamud.dll</HintPath></Reference>
    <Reference Include="FFXIVClientStructs"><HintPath>$(DalamudDir)/FFXIVClientStructs.dll</HintPath></Reference>
    <Reference Include="InteropGenerator.Runtime"><HintPath>$(DalamudDir)/InteropGenerator.Runtime.dll</HintPath></Reference>
    <Reference Include="Lumina"><HintPath>$(DalamudDir)/Lumina.dll</HintPath></Reference>
  </ItemGroup>
</Project>
